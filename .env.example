# 基础配置
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-random-32-char-string

# 数据库配置（生产环境）
DATABASE_URL=postgresql://user:password@localhost:5432/bank_ai_os

# Supabase 配置（开发环境）
# 当 DEMO_MODE=false 时，COZE_SUPABASE_URL 或 DATABASE_URL 至少需要配置一个
# 同时需要配置 COZE_SUPABASE_ANON_KEY 或 COZE_SUPABASE_SERVICE_ROLE_KEY
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Redis（可选）
REDIS_URL=

# AI 配置
# AI_DEFAULT_PROVIDER: 供应商类型，支持 openai_compatible/openai/qwen/vllm
# AI_DEFAULT_MODEL: 默认模型名称，需为 OpenAI 支持的模型（如 gpt-4o-mini, gpt-4o）
# AI_PROVIDER_OPENAI_BASE_URL: OpenAI 兼容 API 的 Base URL，需指向 /v1 端点
# AI_PROVIDER_OPENAI_API_KEY: API Key，格式为 sk- 前缀
AI_DEFAULT_PROVIDER=openai_compatible
AI_DEFAULT_MODEL=gpt-4o-mini
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai-next.com/v1
AI_PROVIDER_OPENAI_API_KEY=
AI_FALLBACK_CHAIN=primary,backup

# 文件存储
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 认证配置
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# 功能模块
FEATURE_MODULES=workbench,task,collab,office,knowledge,enterprise,research,customer,analytics,cockpit,risk,marketing
# 演示模式：true 时使用内置演示用户，无需数据库；false 时需要配置数据库凭证
# 生产环境必须设为 false，开发环境可设为 true 使用演示模式
DEMO_MODE=false